# Formulario de contacto (app/actions/contact.ts) — el envío está simulado hoy;
# estas variables son las que usaría la integración real con Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=team@arcadevault.example
CONTACT_FROM_EMAIL=noreply@arcadevault.example

# --- Supabase: DESARROLLO ---
# El proyecto al que Claude Code accede por MCP (ver .mcp.json). Local/dev apunta aquí.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=xxxxxxx

# --- Supabase: PRODUCCIÓN ---
# Proyecto separado (ver specs/23-migracion-a-produccion.md). Claude Code no tiene
# acceso a él: no se configura en .mcp.json ni en ninguna otra herramienta de agente.
# Estos valores solo se usan en Vercel, scope Production.
# NEXT_PUBLIC_SUPABASE_URL=https://yyyyyy.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=yyyyyyy

# No la lee ningún código del repo (no hay CLI de Supabase configurada, specs/04 y
# specs/06 decidieron explícitamente no usarla) — queda aquí como recordatorio de que
# hace falta si en algún momento se adopta `supabase db push` u otra herramienta CLI.
SUPABASE_DB_PASSWORD=xxxx
